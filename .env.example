# Скопируйте в .env на сервере и заполните. В репозитории — только этот пример.
# Комментарии — отдельными строками: значение в строке должно быть чистым.

# --- Биржа АТИ ---
# ID приложения интегратора и токен доступа (кабинет АТИ → API → приложение → токен)
ATI_CLIENT_ID=
ATI_TOKEN=

# Демо-парк в пустой базе — только для локальной разработки (1); на проде пусто
DEMO_SEED=

# --- Языковая модель: любой OpenAI-совместимый /chat/completions ---
# Смена провайдера — только здесь, код не трогаем.
# Чат: DeepSeek через Yandex AI Studio — тот же ключ, что у голоса, оплата российской картой.
# Звонки: Yandex Realtime (блок «Голос» ниже) — у него минимальная задержка.
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder_id>/deepseek-v4-flash/latest
LLM_API_KEY=
LLM_JSON_MODE=json_object
LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.3
# Цены модели за 1000 токенов, ₽ — для учёта расходов (страница «Настройки»)
LLM_RUB_PER_1K_IN=0
LLM_RUB_PER_1K_OUT=0

# DeepSeek напрямую (нужен свой ключ, оплата иностранной картой):
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# YandexGPT вместо DeepSeek (тот же ключ Yandex):
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest

# Локальная разработка без ключей: Codex CLI или мок через llm_proxy.py (run.sh поднимет его на 8011)
# LLM_PROXY_MODE=codex
# LLM_BASE_URL=http://127.0.0.1:8011/v1
# LLM_MODEL=codex
# LLM_JSON_MODE=json_schema
# LLM_TIMEOUT=240
# CODEX_TIMEOUT меньше LLM_TIMEOUT, иначе клиент уйдёт на повтор, пока codex ещё думает
# CODEX_TIMEOUT=230
# CODEX_PARALLEL=2

# --- Звонки (ТЗ 2.2) ---
# TELEPHONY: пусто/off — звонков нет; megafon — ВАТС МегаФон; mock — имитация для разработки (расшифровки выдуманные!)
TELEPHONY=
# MEGAFON_API_URL=https://<vats>.megapbx.ru/sys/crm_api.wcgp
# MEGAFON_API_KEY=
# логин сотрудника-бота в ВАТС
# MEGAFON_BOT_USER=
# Вебхук ВАТС: https://<домен>/api/telephony/webhook/<секрет>; не короче 32 символов: openssl rand -hex 24
TELEPHONY_WEBHOOK_SECRET=
# откуда разрешено скачивать записи (хост ВАТС из MEGAFON_API_URL добавляется сам)
RECORDING_HOSTS=
# одновременных звонков (линий сотрудника-бота)
CALL_LINES=1
# связь, ₽/мин; голос по умолчанию = VOICE_RUB_SEC × 60
CALL_RUB_PER_MIN=3
# SPEECH_RUB_PER_MIN=6
# имитация: через сколько секунд «звонок» закончится и с каким итогом (done/no_answer/busy/failed)
# MOCK_CALL_SECONDS=3
# MOCK_CALL_OUTCOME=done

# --- Голос агента: Yandex AI Studio Realtime ---
# Ключ сервисного аккаунта с ролью ai.languageModels.user; без него кнопки тестового звонка нет
YC_FOLDER_ID=
YC_API_KEY=
YC_RT_MODEL=speech-realtime-max-tts-live/latest
# YC_RT_VOICE=sergey
# отдельный ключ/адрес для голоса, если нужен
# YC_RT_API_KEY=
# YC_RT_URL=
# максимум одного тестового звонка, сек; тишина до автоотбоя, сек
VOICE_CALL_SEC=240
VOICE_IDLE_SEC=25
# пауза собеседника (мс), после которой агент начинает отвечать
VOICE_SILENCE_MS=1100
# оценка ₽/сек (≈6 ₽/мин) и потолок трат на тестовые звонки в день, ₽
VOICE_RUB_SEC=0.1
VOICE_RUB_DAY=50

# --- Прод (docker compose) ---
# Домен клиента или <ip-через-дефисы>.sslip.io — Caddy сам получит HTTPS-сертификат
SITE=
# COOKIE_SECURE=1 и BACKUP_DIR задаёт docker-compose.yml; локально по http оставьте пустым
# Бэкапы: время и срок хранения; ключи хранилища — в backup.env (см. backup.env.example)
BACKUP_AT=03:30
KEEP_DAYS=14
