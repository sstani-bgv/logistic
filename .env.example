ATI_CLIENT_ID=
ATI_TOKEN=

# --- Языковая модель: любой OpenAI-совместимый /chat/completions ---
# Смена провайдера — только здесь, код не трогаем.

# Локально: Codex CLI через llm_proxy.py (run.sh поднимет его сам на 8011).
# LLM_PROXY_MODE=mock — без сети и ключей, детерминированные ответы (демо, тесты).
LLM_PROXY_MODE=codex
LLM_BASE_URL=http://127.0.0.1:8011/v1
LLM_MODEL=codex
LLM_API_KEY=
LLM_JSON_MODE=json_schema
LLM_TIMEOUT=240

# Yandex Cloud AI Studio (оплата российской картой):
# LLM_PROXY_MODE=
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_API_KEY=<API-ключ сервисного аккаунта>
# LLM_JSON_MODE=json_object
# LLM_TIMEOUT=60

# DeepSeek:
# LLM_PROXY_MODE=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# LLM_JSON_MODE=json_object
# LLM_TIMEOUT=60

# LLM_TEMPERATURE=0.3
