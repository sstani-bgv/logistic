{
	# UDP 443 наружу не открыт: без этого Caddy объявляет HTTP/3, и браузеры ждут ответа впустую
	servers {
		protocols h1 h2
	}
}
{$SITE} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy app:8010
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' wss://{$SITE}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		Alt-Svc clear
	}
}
# Проверка связи по голому IP: без этого Caddy уводит на https, а сертификата на IP нет — выглядит как «сайт не работает»
http:// {
	log
	header Content-Type "text/plain; charset=utf-8"
	header Cache-Control no-store
	respond "Связь с сервером есть."
}
