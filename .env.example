ATI_CLIENT_ID=
ATI_TOKEN=

# Демо-парк в пустой базе — только локально
DEMO_SEED=1

# --- Языковая модель: любой OpenAI-совместимый /chat/completions ---
# Смена провайдера — только здесь, код не трогаем.

# Локально: Codex CLI через llm_proxy.py (run.sh поднимет его сам на 8011).
# LLM_PROXY_MODE=mock — без сети и ключей, детерминированные ответы (демо, тесты).
LLM_PROXY_MODE=codex
LLM_BASE_URL=http://127.0.0.1:8011/v1
LLM_MODEL=codex
LLM_API_KEY=
LLM_JSON_MODE=json_schema
LLM_TIMEOUT=240
# CODEX_TIMEOUT меньше LLM_TIMEOUT, иначе клиент уйдёт на повтор, пока codex ещё думает
CODEX_TIMEOUT=230

# Yandex Cloud AI Studio (оплата российской картой):
# LLM_PROXY_MODE=
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_API_KEY=<API-ключ сервисного аккаунта>
# LLM_JSON_MODE=json_object
# LLM_TIMEOUT=60

# DeepSeek:
# LLM_PROXY_MODE=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# LLM_JSON_MODE=json_object
# LLM_TIMEOUT=60

# LLM_TEMPERATURE=0.3

# --- Звонки (ТЗ 2.2) ---
# TELEPHONY=mock — имитация звонка локально; megafon — ВАТС МегаФон + голосовой бот
TELEPHONY=mock
MOCK_CALL_SECONDS=3
# MEGAFON_API_URL=https://<vats>.megapbx.ru/sys/crm_api.wcgp
# MEGAFON_API_KEY=
# MEGAFON_BOT_USER=          # логин сотрудника-бота в ВАТС
# Вебхук ВАТС и голосового бота: https://<домен>/api/telephony/webhook/<секрет>
TELEPHONY_WEBHOOK_SECRET=
CALL_RUB_PER_MIN=3
SPEECH_RUB_PER_MIN=0

# --- Прод (docker compose) ---
# Домен клиента или <ip-через-дефисы>.sslip.io — Caddy сам получит HTTPS-сертификат
SITE=
# COOKIE_SECURE=1 задаёт docker-compose.yml; локально по http оставьте пустым

# --- Бэкапы: Yandex Object Storage (или любое S3) ---
BACKUP_BUCKET=
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Other
RCLONE_CONFIG_S3_ENDPOINT=https://storage.yandexcloud.net
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
BACKUP_AT=03:30
KEEP_DAYS=14
