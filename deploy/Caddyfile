{
	# HTTP/3 is not exposed by this deployment, so do not advertise it.
	servers {
		protocols h1 h2
	}
}

{$SITE} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy app:8010
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		Alt-Svc clear
	}
}

# Plain-IP diagnostic endpoint: it proves that the host is reachable without
# exposing authentication or customer data over unencrypted HTTP.
http:// {
	log
	header Content-Type "text/plain; charset=utf-8"
	header Cache-Control no-store
	respond "Связь с сервером есть."
}
